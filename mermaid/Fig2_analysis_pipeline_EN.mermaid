%%{init: {
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Liberation Sans, Arial, Helvetica, sans-serif",
    "fontSize": "13px",
    "lineColor": "#5C6B57",
    "primaryTextColor": "#14201A",
    "edgeLabelBackground": "#FFFFFF"
  },
  "flowchart": { "curve": "basis", "nodeSpacing": 48, "rankSpacing": 50, "padding": 10, "wrappingWidth": 400 }
}}%%
flowchart TD

  RAW["<b>Raw data: 484 observations</b><br/>204 accessions × 2024 · 2025 · 2026"]

  RAW --> CONT["Continuous traits (6)<br/>fruit weight · petal number · SSC · TA<br/>bloom DOY · development period"]
  RAW --> CATG["Categorical traits (14)<br/>10 ordinal · 4 nominal"]

  CONT --> LMM["<b>Linear mixed model</b><br/>y = μ + year + accession + harvest batch + e"]
  CATG --> RATER["<b>Survey years treated as raters</b><br/>99 accessions with complete three-year records"]

  LMM   --> REP["<b>Repeatability R</b><br/>from the variance components<br/>σ²G / (σ²G + σ²e)"]
  LMM   --> BLUP["<b>Accession BLUP</b><br/>from the random effects<br/>shrunken representative value"]
  RATER --> KAP["<b>Fleiss κ</b><br/>chance-corrected agreement<br/>across the survey years"]
  RATER --> MODE["<b>Mode · UPOV median</b><br/>categorical representative value"]

  REP  -- "Spearman–Brown"  --> W["<b>Composite reliability w</b><br/>all 20 traits on one 0–1 scale"]
  KAP  -- "κ used directly" --> W
  BLUP --> MAT["<b>Accession-level matrix</b><br/>204 accessions × 20 traits"]
  MODE --> MAT

  W   -- "weights"     --> GOW["<b>Reliability-weighted Gower distance</b><br/>D(i,j) = √[Σ w · d(i,j) / Σ w]"]
  MAT -- "coordinates" --> GOW

  GOW -- "204 × 204 distance matrix" --> WARD["<b>Ward.D2 hierarchical clustering</b><br/>k chosen at maximum mean silhouette"]
  WARD --> OUT["<b>k = 4</b><br/>44 double-flowered accessions<br/>160 single-flowered accessions split by leaf base shape<br/>obtuse 85 · truncate 26 · acute 49<br/>mean silhouette 0.148"]

  classDef source      fill:#FFFFFF,stroke:#14201A,stroke-width:1.4px,color:#14201A
  classDef reliability fill:#E6EBDD,stroke:#2F5D3A,stroke-width:1.8px,color:#14201A
  classDef value       fill:#F4F6EF,stroke:#9AA891,stroke-width:1.1px,color:#14201A
  classDef result      fill:#2F5D3A,stroke:#2F5D3A,stroke-width:1.8px,color:#FFFFFF

  class RAW,CONT,CATG,LMM,RATER,WARD source
  class REP,KAP,W,GOW reliability
  class BLUP,MODE,MAT value
  class OUT result

  linkStyle 4,6,8,9,12 stroke:#2F5D3A,stroke-width:2.2px
